# Golden Goose configuration. Copy to .env and fill in real values.
# Every value here has a safe local default in code; only provider API keys
# are required for real (non-fake) inference.

# --- Environment ---
GG_ENVIRONMENT=local
GG_LOG_LEVEL=INFO

# --- Provider API keys (leave blank to run with deterministic fakes) ---
GG_ANTHROPIC_API_KEY=
GG_VOYAGE_API_KEY=
GG_GOOGLE_API_KEY=
GG_TAVILY_API_KEY=
# Set true in any environment where fake providers must never stand in.
GG_REQUIRE_REAL_PROVIDERS=false

# --- Models ---
GG_LLM_MODEL=claude-sonnet-5
GG_LLM_SMALL_MODEL=claude-haiku-4-5-20251001
GG_EMBEDDING_MODEL=voyage-4-large
GG_EMBEDDING_DIMENSIONS=1024
GG_RERANK_MODEL=rerank-2.5
GG_OCR_MODEL=gemini-3-flash

# --- Postgres ---
GG_PG_HOST=localhost
GG_PG_PORT=5432
GG_PG_USER=gg_app
GG_PG_PASSWORD=gg_app_dev_password
GG_PG_DATABASE=goldengoose
GG_PG_ADMIN_USER=gg_admin
GG_PG_ADMIN_PASSWORD=gg_admin_dev_password

# --- Qdrant ---
GG_QDRANT_URL=http://localhost:6333
GG_QDRANT_COLLECTION=gg_chunks

# --- Neo4j ---
GG_NEO4J_URI=bolt://localhost:7687
GG_NEO4J_USER=neo4j
GG_NEO4J_PASSWORD=gg_neo4j_dev_password

# --- Object store (SeaweedFS locally, S3/Blob in cloud) ---
GG_S3_ENDPOINT_URL=http://localhost:8333
GG_S3_ACCESS_KEY=gg_dev_access
GG_S3_SECRET_KEY=gg_dev_secret
GG_S3_BUCKET_DOCUMENTS=gg-documents
GG_S3_BUCKET_ARTIFACTS=gg-artifacts

# --- Auth ---
GG_AUTH_JWT_SECRET=dev_only_jwt_secret_change_me_0123456789
GG_AUTH_JWT_ISSUER=golden-goose-local

# --- External regulatory data tools ---
# Public APIs (openFDA, eCFR, ClinicalTrials.gov, PubMed) need no key; a key
# raises openFDA rate limits. Set offline=true to serve deterministic
# synthetic payloads instead of calling any external API (CI, air-gapped).
GG_EXTERNAL_OFFLINE=false
GG_EXTERNAL_OPENFDA_API_KEY=
GG_EXTERNAL_RESULT_LIMIT=10
GG_EXTERNAL_CACHE_TTL_SECONDS=3600
GG_EXTERNAL_MIN_INTERVAL_MS=250

# --- Tracing (Arize Phoenix, OTLP/HTTP) ---
# Start the collector with: docker compose --profile obs up -d
# Spans export only when enabled; the instrumentation is a no-op otherwise.
GG_TRACING_ENABLED=false
GG_TRACING_ENDPOINT=http://localhost:6006/v1/traces
GG_TRACING_SERVICE_NAME=golden-goose

# --- Internal-API connectors ---
# Read-only connectors to internal business systems (eQMS, ERP, LIMS),
# registered purely through configuration. JSON array; each entry declares a
# name, title, base_url, a whitelist of GET resources, and optionally the env
# var holding its credential plus restricted=true for complaint-adjacent
# feeds (refused to auditor_readonly). Example:
#   [{"name": "eqms", "title": "eQMS", "base_url": "https://eqms.internal",
#     "resources": {"open_changes": "/api/v1/changes"},
#     "api_key_env": "EQMS_API_KEY", "restricted": false}]
# The named env var (e.g. EQMS_API_KEY) holds that connector's credential and
# is read only by that connector.
GG_INTERNAL_CONNECTORS_JSON=[]
GG_INTERNAL_RESULT_LIMIT=50
GG_INTERNAL_TIMEOUT_SECONDS=10
